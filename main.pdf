11 dict begin
/FontType 1 def
/FontMatrix [0.001 0 0 0.001 0 0 ]readonly def
/FontName /MMVYAW+CMR8 def
/FontBBox {-36 -250 1070 750 }readonly def
/PaintType 0 def
