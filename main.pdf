/FamilyName (Computer Modern) readonly def
/Weight (Medium) readonly def
/ItalicAngle 0 def
/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 91 /bracketleft put
dup 93 /bracketright put
dup 100 /d put
dup 61 /equal put
dup 105 /i put
dup 109 /m put
dup 111 /o put
dup 49 /one put
dup 43 /plus put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
